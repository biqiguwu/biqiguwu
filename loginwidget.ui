QComboBox,QLineEdit
{
	border:none;
	border-bottom:1px solid rgb(229,229,229);
	font:normal 18px &quot;楷体&quot;;
	
}
QComboBox:hover,QLineEdit:hover
{
	border-bottom:1px solid rgb(193,193,193);
}

QComboBox:focus,QLineEdit:focus
{
	border-bottom:1px solid rgb(18,183,245);
}

QComboBox::drop-down
{
	min-width:26px;
	border-image: url(:/drop-down.png);
}

QComboBox::drop-down:hover
{
	min-width:28px;
	border-image: url(:/drop-hover.png);
}

QComboBox::drop-down:checked
{
	min-width:30px;
	border-image: url(:/drop-up.png);
}

QLabel#avatar{
	
	image: url(:/2.bmp);
}
QPushButton#registbt:hover{
	
	color: rgb(0, 85, 255);
}
